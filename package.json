{
  "name": "doyun-tcg",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "worker:dev": "wrangler dev --ip 127.0.0.1",
    "db:local": "wrangler d1 migrations apply DB --local",
    "verify": "npm run typecheck && npm test && npm run build && wrangler deploy --dry-run",
    "admin:local": "node scripts/admin.mjs"
  },
  "dependencies": {
    "hono": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "esbuild": "latest",
    "miniflare": "^5.20261012.0-beta",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
